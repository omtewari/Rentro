# API
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:8081

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentro?schema=public

# Auth (replace with strong secrets before use)
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
